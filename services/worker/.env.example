# Database stuff
DATABASE_URL=


# S3 stuff
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# compatibility for non amazon providers
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# Worker stuff
# Maximum seconds a job may run before it is killed and reported as an error
WORKER_JOB_TIMEOUT=60
# Maximum seconds the worker sleeps before checking the queue, even without a NOTIFY
WORKER_WAKEUP_TIMEOUT=60
# Programs with more cycles than this are not displayed; the full pipeline goes to a CSV instead
PIPELINE_DISPLAY_CYCLE_LIMIT=3000

# Toolchain and simulator (paths inside the ase-web-worker image)
# Folder with the RISC-V gcc and objdump used to build the job's program
RISCV_TOOLCHAIN_PATH=
# gem5 executable used to simulate the job
GEM5_INSTALLATION_PATH=
# gem5 source tree, used by setup_default
GEM5_SRC=
# gem5 script for in-order jobs (out-of-order jobs always use gem5/riscv_o3_custom.py)
GEM5_SIMULATION_SCRIPT=
# Uncomment to accept the memory/cache fields of the job config (otherwise they are reset to defaults).
# Any value enables it, even an empty one: to disable it, the line must stay commented out.
# ASE_STUDIO_DEVELOPER=1
